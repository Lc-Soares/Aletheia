# Não executa scripts de instalação de dependências (vetor comum de ataques à cadeia de suprimentos).
# Se um pacote realmente precisar compilar (por exemplo sharp ou esbuild), libere só ele:
#   npm rebuild <pacote> --ignore-scripts=false
ignore-scripts=true

# Só instala versões publicadas há pelo menos 7 dias (unidade: dias). Exige npm 11.10 ou superior.
min-release-age=7

# Impede dependências instaladas direto de repositórios git.
allow-git=none
